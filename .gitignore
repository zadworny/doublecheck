# Rust / Soroban
target/
**/*.rs.bk

# Node
node_modules/
dist/
*.local

# Host tooling
.vercel/

# Secrets — Stellar identities live in ~/.config/stellar, never in the repo
.env
.env.*
!.env.example
.stellar/

# Loose documents dropped in the working copy. This is a public repo and
# `git add -A` will happily sweep up anything sitting at the root, so keep
# stray PDFs out by default. Documentation lives in docs/ and is not affected.
/*.pdf

# OS / editors
.DS_Store
.idea/
*.swp

# Internal-only copy of the architecture doc (full text, incl. redacted sections)
docs/*.internal.md
