# Which registry contract the explorer reads. Defaults to the testnet
# deployment baked into the generated bindings, so the app works with no
# configuration at all.
VITE_CONTRACT_ID=CDY4WIUWUJWDW4AKPTYFXTRONQQVS52PS2ZYFU2S5HEMW2U7LM5KRHKP
VITE_RPC_URL=https://soroban-testnet.stellar.org
VITE_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Private intake bridge. Set these as server-side Vercel environment variables,
# not as VITE_* values: VITE_* values are compiled into the public browser JS.
# The endpoint returns 503 and the UI reports that nothing was sent when the
# webhook is absent. The bearer token is optional.
INTAKE_WEBHOOK_URL=
INTAKE_WEBHOOK_BEARER_TOKEN=
